# Copy to .env — the only manual step. No real secrets here: dev defaults only.
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog_dev_password
POSTGRES_DB=catalog
DATABASE_URL=postgres://catalog:catalog_dev_password@postgres:5432/catalog

API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://api:4000

# Session cookie signing / hashing pepper — change outside local dev.
SESSION_SECRET=change-me-dev-only-32-chars-minimum!!
COOKIE_SECURE=false
# Number of trusted reverse proxies in front of api (0 = ignore X-Forwarded-For).
TRUST_PROXY_HOPS=0

# Seed users (logins: admin, editor1, editor2, viewer). Dev-only passwords, listed in README.
SEED_ADMIN_PASSWORD=admin-pass-123
SEED_EDITOR1_PASSWORD=editor1-pass-123
SEED_EDITOR2_PASSWORD=editor2-pass-123
SEED_VIEWER_PASSWORD=viewer-pass-123
