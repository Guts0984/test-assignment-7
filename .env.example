# cp .env.example .env  -- the only manual step. Dev defaults, no real secrets.
# One file serves BOTH `docker compose up` and local `pnpm dev`
# (compose replaces the host names below with its own in-network ones).

POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog_dev_password
POSTGRES_DB=catalog
POSTGRES_PORT=5432

# Local development (pnpm dev). Inside Docker these two are overridden by compose.
DATABASE_URL=postgres://catalog:catalog_dev_password@localhost:5432/catalog
API_INTERNAL_URL=http://localhost:4000

API_PORT=4000
WEB_PORT=3000

# Cookie/session hardening. Change SESSION_SECRET outside local dev.
SESSION_SECRET=change-me-dev-only-32-chars-minimum!!
COOKIE_SECURE=false
# Origin the browser uses to open the web app (CSRF origin check).
CORS_ORIGIN=http://localhost:3000
# Number of trusted reverse proxies in front of the API (0 = ignore X-Forwarded-For).
TRUST_PROXY_HOPS=0

# Seed users (logins: admin, editor1, editor2, viewer). Dev-only passwords, listed in the README.
SEED_ADMIN_PASSWORD=admin-pass-123
SEED_EDITOR1_PASSWORD=editor1-pass-123
SEED_EDITOR2_PASSWORD=editor2-pass-123
SEED_VIEWER_PASSWORD=viewer-pass-123
